{
  "description": "Weekly spending tracker: add spending, weekly summary with an 80% warning, categories, and multi-week history. Persian + English. Built 0-100 with ORCINUS.",
  "license": "MIT",
  "name": "weekly-budget",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "tsc && node --test dist/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "mutation": "stryker run",
    "start": "node dist/src/server.js",
    "dev": "tsc && node dist/src/server.js"
  },
  "type": "module",
  "version": "0.1.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
